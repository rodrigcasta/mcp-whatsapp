# Copiar a .env para desarrollo. Las credenciales reales nunca van al repo.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=example
POSTGRES_DB=postgres

# Token que se carga en el panel de Meta al configurar el webhook
META_TOKEN_VERIFICACION=cambiar
# Secreto de la app de Meta, con el que se valida la firma X-Hub-Signature-256 de cada notificación
META_SECRETO_APP=cambiar
